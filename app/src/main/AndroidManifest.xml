<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gigs are mirrored into a device calendar the user picks. When that calendar belongs to a
         Google account, the platform's own sync adapter carries the events up to Google, which is
         why no OAuth, Cloud project or Play Services dependency is needed here. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Package visibility. From API 30 an app sees only the packages it declares an interest in,
         and both halves of the share sheet have to be seen to be told apart: who answers a
         mailto:, and who answers the send this app is about to make. Without these the queries
         come back empty, every target looks like a mail app, and the subject goes back to being
         silently dropped by the messengers. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rechnungsplaner">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.GigEditActivity" android:exported="false" />
        <activity android:name=".ui.CustomerListActivity" android:exported="false" />
        <activity android:name=".ui.CustomerEditActivity" android:exported="false" />
        <activity android:name=".ui.IssuerEditActivity" android:exported="false" />
        <activity android:name=".ui.InvoiceActivity" android:exported="false" />
        <activity android:name=".ui.InvoiceListActivity" android:exported="false" />
        <activity android:name=".ui.ExportActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.CalendarImportActivity" android:exported="false" />

        <!-- The framework has no FileProvider; this serves generated invoices to the share sheet
             from one directory under cacheDir. Not exported: recipients reach it only through the
             read grant attached to the share intent. -->
        <provider
            android:name=".util.ShareProvider"
            android:authorities="com.shaforostoff.rechnungsplaner.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>

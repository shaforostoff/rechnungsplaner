<?xml version="1.0" encoding="utf-8"?>
<!-- The blue the artwork sits on. The foreground circle covers the inner 72dp of this 108dp
     canvas, so the ramp is the artwork's own top-to-bottom gradient extended to the full canvas:
     at 18dp and 90dp it is exactly the colour of the circle's top and bottom edge, which is what
     keeps the circle's rim invisible under masks that reach past it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:startColor="#3A6EE8"
                android:endColor="#113E99" />
        </aapt:attr>
    </path>

</vector>
